DIRECTUS_PUBLIC_URL=http://localhost:8055

# Generate long random strings
DIRECTUS_KEY=replace-with-random-key
DIRECTUS_SECRET=replace-with-random-secret

# Bootstrap admin account (first startup)
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change_this_directus_admin_password

# Optional
DIRECTUS_CORS_ORIGIN=true

# Local Directus -> tunneled production Postgres
DB_CLIENT=pg
DB_HOST=host.docker.internal
DB_PORT=55432
DB_DATABASE=app
DB_USER=app
DB_PASSWORD=change_this_postgres_password
