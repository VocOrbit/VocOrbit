# Copy to .env (gitignored). Every value is optional: app.config.ts falls back to the
# Firebase config files (copy GoogleService-Info.example.plist / google-services.example.json)
# and to app.json > expo.extra.vocorbit.

# Paths to the Firebase config files
FIREBASE_IOS_GOOGLE_SERVICES_FILE=./GoogleService-Info.plist
FIREBASE_ANDROID_GOOGLE_SERVICES_FILE=./google-services.json

# Overrides for values normally read from the Firebase config files
GOOGLE_IOS_URL_SCHEME=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
FIREBASE_WEB_API_KEY=

# Web sign-in (Apple via Firebase Auth, Google via Identity Toolkit)
APPLE_WEB_CLIENT_ID=
APPLE_WEB_REDIRECT_URI=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=

# Backend overrides (defaults: app/config)
BACKEND_API_URL=
REFERRAL_SHARE_BASE_URL=
# Development only: skips Google/Apple sign-in and sends this Firebase ID token to the API.
BACKEND_AUTH_TEST_ID_TOKEN=
