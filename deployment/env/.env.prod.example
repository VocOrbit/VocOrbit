# ------------------------------------------------------------------------------
# Compose/build settings
# ------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=vocorbit-server
APP_IMAGE=vocorbit-server:prod
BUN_VERSION=1.3.8

# Container memory limits (tune by server size)
POSTGRES_MEM_LIMIT=1536m
REDIS_MEM_LIMIT=512m
API_MEM_LIMIT=768m
WORKER_MEM_LIMIT=512m

# ------------------------------------------------------------------------------
# Infrastructure service credentials
# ------------------------------------------------------------------------------
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_BIND_PORT=55432

REDIS_PASSWORD=change_this_redis_password

NATS_USER=app
NATS_PASSWORD=change_this_nats_password

# ------------------------------------------------------------------------------
# App runtime
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
LOG_LEVEL=warn
AUTH_MODE=firebase
APP_REGION=eu
# Used when a user has no pre-assigned home region.
HOME_REGION_DEFAULT=eu
# Total shard count per region for deterministic user/job partitioning.
REGION_SHARD_COUNT=16

DATABASE_URL=postgres://app:change_this_postgres_password@postgres:5432/app
REDIS_URL=redis://:change_this_redis_password@redis:6379/0
NATS_URL=nats://app:change_this_nats_password@nats:4222

OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=vocorbit-server-api
# Sampling ratio for traces (0.0 - 1.0). Lower values reduce Jaeger load.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.2
# Jaeger storage/memory budget.
JAEGER_STORAGE_TYPE=badger
JAEGER_BADGER_EPHEMERAL=false
JAEGER_MEM_LIMIT=512m

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

JWT_SECRET=change_this_jwt_secret_min_32_chars
JWT_ISSUER=vocorbit-server
JWT_AUDIENCE=elysia-api
JWT_ACCESS_TOKEN_TTL_SEC=900
JWT_REFRESH_TOKEN_TTL_SEC=2592000

CORS_ORIGIN=https://api.example.com,https://app.example.com
TRUST_PROXY=true

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_PREFIX=rate

REQUEST_LOCK_TTL_MS=30000
REQUEST_LOCK_PREFIX=request-lock

WS_WORD_INSIGHT_IDLE_TIMEOUT_MS=120000
WS_WORD_INSIGHT_HEARTBEAT_INTERVAL_MS=30000
WS_WORD_INSIGHT_MAX_CONNECTIONS_PER_USER=3

# If false, API containers only enqueue jobs; dedicated worker-* containers process them.
WORD_INSIGHT_JOB_RUNNER_ENABLED=false
# Per-process parallel job count. 2 is a good default on 4GB/2vCPU.
WORD_INSIGHT_JOB_CONCURRENCY=2
WORD_INSIGHT_JOB_TICK_MS=500
# Worker heartbeat timeout used by Docker healthcheck.
WORD_INSIGHT_WORKER_HEARTBEAT_TIMEOUT_MS=120000

WORD_INSIGHT_PROVIDER=deepseek
WORD_INSIGHT_DEFAULT_SOURCE_LANG=en  # Learning Lang
WORD_INSIGHT_DEFAULT_TARGET_LANG=tr  # Mother Lang
WORD_INSIGHT_MAX_SENTENCE_CHARS=280
WORD_INSIGHT_MAX_SELECTED_WORD_CHARS=120

EXERCISES_DEFAULT_TOTAL_QUESTIONS=10
EXERCISES_MAX_TOTAL_QUESTIONS=20
EXERCISES_DEFAULT_TODAY_MINIMUM=5
EXERCISES_MAX_TODAY_MINIMUM=20
EXERCISES_MAX_LEARNING_ITEMS_SCAN=300

CREDITS_DEFAULT_FREE_BASIC=10
CREDITS_DEFAULT_FREE_ADVANCED=3
CREDITS_PAID_BASIC_CAP=200
CREDITS_PAID_ADVANCED_CAP=100
CREDITS_MONTHLY_PAID_BASIC_TOPUP=0
CREDITS_MONTHLY_PAID_ADVANCED_TOPUP=0
CREDITS_MONTHLY_TOPUP_INTERVAL_DAYS=30

BILLING_WEBHOOK_SECRET=change_this_webhook_secret
BILLING_ALLOW_TEST_RECEIPTS=false
BILLING_SKU_CATALOG_JSON=
BILLING_APPLE_JWKS_URL=https://api.storekit.itunes.apple.com/inApps/v1/notifications/jwsPublicKeys
BILLING_APPLE_BUNDLE_ID=
BILLING_GOOGLE_PLAY_PUBLIC_KEY=
BILLING_GOOGLE_PACKAGE_NAME=
BILLING_GOOGLE_REQUIRE_SIGNATURE=true
BILLING_GOOGLE_PUBSUB_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# Google Play webhooks are rejected until both are set. They must match the Pub/Sub push
# subscription's authentication settings: its audience (defaults to the push endpoint URL)
# and the service account that signs the push tokens.
BILLING_GOOGLE_PUBSUB_AUDIENCE=
BILLING_GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=
BILLING_GOOGLE_PUBSUB_ISSUERS=accounts.google.com,https://accounts.google.com

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=15000

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TIMEOUT_MS=45000

CACHE_TTL_MS=60000
CACHE_PREFIX=cache

METRICS_ENABLED=true
MAX_BODY_BYTES=1048576

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password
# cAdvisor image (GHCR tag format usually without "v" prefix).
CADVISOR_IMAGE=ghcr.io/google/cadvisor:0.55.1
DOCKER_API_VERSION=1.44
# cAdvisor bind source for Docker data root. For snap Docker use:
# DOCKER_ROOT_DIR=/var/snap/docker/common/var-lib-docker
DOCKER_ROOT_DIR=/var/lib/docker
# Docker socket path used by cAdvisor. For rootless Docker it can be:
# DOCKER_SOCK_PATH=/run/user/1000/docker.sock
DOCKER_SOCK_PATH=/var/run/docker.sock

DIRECTUS_BIND_PORT=8055
DIRECTUS_PUBLIC_URL=http://localhost:8055
DIRECTUS_KEY=change_this_directus_key
DIRECTUS_SECRET=change_this_directus_secret
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change_this_directus_admin_password
DIRECTUS_CORS_ORIGIN=true

MOBILE_UPDATE_TITLE=New update available
MOBILE_UPDATE_MESSAGE=Please update to the latest version for the best experience.
MOBILE_MIN_VERSION_IOS=
MOBILE_LATEST_VERSION_IOS=
MOBILE_STORE_URL_IOS=
MOBILE_MIN_VERSION_ANDROID=
MOBILE_LATEST_VERSION_ANDROID=
MOBILE_STORE_URL_ANDROID=
