ARG BUN_VERSION=1.3.8

FROM oven/bun:${BUN_VERSION} AS deps
WORKDIR /app
COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile

FROM deps AS build
COPY . .
RUN bun run build
RUN bun build apps/api/src/word-insight-worker.ts --outdir dist --target bun --sourcemap
RUN bun build infra/database/src/migrate.ts --outdir dist --target bun --sourcemap

FROM oven/bun:${BUN_VERSION} AS runtime
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build /app/dist ./dist
COPY --from=build /app/infra/database/migrations ./infra/database/migrations

USER bun
EXPOSE 3000
CMD ["bun", "dist/main.js"]
