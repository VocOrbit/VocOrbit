  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Cloudflare country code from Nginx access logs. Health, readiness, metrics, and OPTIONS requests are excluded.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 10,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Value"
          }
        ]
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (country) (count_over_time({compose_service=\"nginx\", country=~\"[A-Z0-9]{2}\", method!=\"OPTIONS\"} | json | uri!~\"^/(health|healthz|ready|metrics)(\\\\?.*)?$\" [$__range])))",
          "instant": true,
          "legendFormat": "{{country}}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Top Countries",
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Top countries by request volume over time, derived from the Cloudflare country header on Nginx access logs.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 14,
        "x": 10,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "pluginVersion": "11.1.0",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "topk(8, sum by (country) (count_over_time({compose_service=\"nginx\", country=~\"[A-Z0-9]{2}\", method!=\"OPTIONS\"} | json | uri!~\"^/(health|healthz|ready|metrics)(\\\\?.*)?$\" [$__interval])))",
          "legendFormat": "{{country}}",
          "queryType": "range",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Country Request Trend",
      "type": "timeseries"
    }
  ],
